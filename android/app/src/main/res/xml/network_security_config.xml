<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Config
    - Blocks all cleartext (HTTP) traffic in production
    - Allows cleartext only on the local loopback in debug builds
    - Trusts user-installed CAs only in debug (not in release)
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system CAs only in release — never user-installed ones -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
